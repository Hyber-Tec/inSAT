# Production config for project insat-hyber: non-secret values only, loaded by
# `firebase deploy` (and the emulators, where functions/.env.local overrides
# them). Secrets never go here: ENCRYPTION_KEY is a Secret Manager secret
# (firebase functions:secrets:set ENCRYPTION_KEY).

# Where the app is served; the first is where invite links point. The API
# also accepts browser calls from each of them.
CLIENT_ORIGIN=https://insatprep.web.app,https://insatprep.firebaseapp.com,https://insat-hyber.web.app,https://insat-hyber.firebaseapp.com

# The platform owners: a verified Google (or email) sign-in with one of these
# addresses is the superadmin.
SUPERADMIN_EMAILS=goochoi913@gmail.com

# Academies bring their own AI key in admin Settings; the platform has none.
REQUIRE_INSTITUTION_KEY=true

MAIL_FROM=insat <onboarding@resend.dev>
