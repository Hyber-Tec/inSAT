# Local config for the API and the admin scripts: copy to functions/.env.local
# (git-ignored). The Functions emulator reads it over .env.insat-hyber, and
# `npm run api` and every `npm run pool:*` script read it.

# Invite links point here in development.
CLIENT_ORIGIN=http://localhost:5180

# Become the superadmin locally by signing in with one of these.
SUPERADMIN_EMAILS=owner@example.test

# Platform Anthropic key: the fallback for academies without their own, and
# what the offline scripts (pool:topup, import-classmarker) bill. Optional.
ANTHROPIC_API_KEY=
REQUIRE_INSTITUTION_KEY=false

# Optional model overrides (aliases: sonnet | opus | haiku). Drafting is fast,
# verification is strong.
# GEN_MODEL=sonnet
# VERIFY_MODEL=opus

# Optional: transactional email for invite links (Resend). Leave blank to show
# invite links to the admin for manual sharing instead of emailing them.
RESEND_API_KEY=
MAIL_FROM=insat <onboarding@resend.dev>

# The admin scripts write to the emulators when these are set, and to the
# production project (Application Default Credentials) when they are not.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8090
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9109
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9209
