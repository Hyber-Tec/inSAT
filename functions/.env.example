# insat API - copy to .env and adjust. Loaded via `node --env-file=.env`.

# Postgres. Local dev uses the docker-compose Postgres (port 5434).
# Production: paste a Neon / Railway connection string here — nothing else changes.
DATABASE_URL=postgresql://satify:satify@localhost:5434/satify

# Secret used to sign student/admin JWTs. CHANGE THIS in production.
JWT_SECRET=dev-only-change-me-satify

# Platform Anthropic key — the fallback used to generate/extract questions when
# an institution hasn't set its OWN key in admin Settings. Generation runs inside
# this API; there is no separate service. Leave blank to require per-institution
# keys (see REQUIRE_INSTITUTION_KEY below).
ANTHROPIC_API_KEY=

# Optional model overrides (aliases: sonnet | opus | haiku). Drafting is fast,
# verification is strong.
# GEN_MODEL=sonnet
# VERIFY_MODEL=opus

# Optional: transactional email for invite links (Resend). Leave blank to show
# invite links to the admin for manual sharing instead of emailing them.
RESEND_API_KEY=
MAIL_FROM=insat <onboarding@resend.dev>

# Encrypts each institution's LLM API key at rest. CHANGE THIS in production
# (defaults to JWT_SECRET + "-enc"). Rotating it invalidates stored keys.
ENCRYPTION_KEY=

# If true, an institution must set its OWN Anthropic key (in admin Settings) to
# generate/upload — no fallback to the platform's satGen key.
REQUIRE_INSTITUTION_KEY=false

# Platform superadmin (created on first boot) — provisions institutions and
# their first admin. Change the password.
SUPERADMIN_EMAIL=superadmin@satify.test
SUPERADMIN_PASSWORD=satify-super
SUPERADMIN_NAME=insat Superadmin

# Demo institution admin (created on first boot inside the default institution).
ADMIN_EMAIL=admin@satify.test
ADMIN_PASSWORD=satify-admin
ADMIN_NAME=insat Admin

# API port and the client origin allowed by CORS.
PORT=3002
CLIENT_ORIGIN=http://localhost:5174
