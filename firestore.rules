rules_version = '2';

// Every read and write goes through the API (functions/, the Admin SDK, which
// these rules do not apply to). A browser never reads Firestore directly: a
// session's form holds the answers, and every query is scoped to the caller's
// institution on the server.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
