# Desmos Graphing Calculator API key.
# Register at https://www.desmos.com/api and paste the key below.
# Leave blank to fall back to the built-in basic calculator on math sections.
VITE_DESMOS_API_KEY=

# Anthropic API key for the admin "upload an image, auto-detect the question"
# flow. Get one at https://console.anthropic.com/.
# Leave blank to require the admin to type the question out manually.
# WARNING: this key is shipped to the browser bundle — local testing only.
VITE_ANTHROPIC_API_KEY=
