{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "insat Exam",
  "version": "0.1.0",
  "identifier": "com.satify.exam",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "insat Exam",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": true,
        "alwaysOnTop": true,
        "decorations": false,
        "maximized": true,
        "focus": true,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
