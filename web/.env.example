# The web app's Firebase config: copy to web/.env.local (git-ignored) and fill
# it in from the Firebase console (Project settings > Your apps > inSAT).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=insat-hyber.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=insat-hyber
VITE_FIREBASE_STORAGE_BUCKET=insat-hyber.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Desmos Graphing Calculator API key.
# Register at https://www.desmos.com/api and paste the key below.
# Leave blank to fall back to the built-in basic calculator on math sections.
VITE_DESMOS_API_KEY=

# Development only - these go in web/.env.development.local (start.sh writes
# it), never in .env.local, which production builds read too:
#   VITE_AUTH_EMULATOR_HOST=127.0.0.1:9109        sign in against the Auth emulator
#   VITE_API_PROXY=http://127.0.0.1:3002          where `vite` sends /api (default: the Functions emulator)
